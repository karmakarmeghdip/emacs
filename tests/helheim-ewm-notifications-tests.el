;;; helheim-ewm-notifications-tests.el --- EDNC tests -*- lexical-binding: t -*-

(require 'ert)
(require 'cl-lib)
(require 'helheim-ewm-notifications)

(defvar ewm-mode nil)

(defconst helheim-ewm-notifications-test--root
  (expand-file-name ".." (file-name-directory (or load-file-name buffer-file-name))))

(defun helheim-ewm-notifications-test--notification ()
  (ednc--notification-create :id 1 :app-name "Chat" :summary "New message"
                             :body "Hello\nworld" :actions '("default" "Open")))

(ert-deftest helheim-ewm-notifications-single-line-clickable-preview ()
  (let* ((notification (helheim-ewm-notifications-test--notification))
         (preview (helheim-ewm-notifications--preview notification))
         (command (lookup-key (get-text-property 0 'keymap preview) [mouse-1]))
         opened)
    (should (string-match-p "Chat — New message — Hello world" preview))
    (should-not (string-match-p "\n" preview))
    (cl-letf (((symbol-function 'helheim-ewm-notifications--activate)
               (lambda (value) (setq opened value))))
      (funcall command nil))
    (should (eq opened notification))))

(ert-deftest helheim-ewm-notifications-default-action-with-activation-token ()
  (let ((notification (helheim-ewm-notifications-test--notification))
        (ewm-mode t)
        calls)
    (setf (ednc-notification-parent notification) '(0)
          (ednc-notification-client notification) ":1.42")
    (cl-letf (((symbol-function 'ewm-create-activation-token) (lambda () "test-token"))
              ((symbol-function 'dbus-send-signal)
               (lambda (&rest args) (push args calls)))
              ((symbol-function 'ednc-invoke-action)
               (lambda (value) (push (list 'action value) calls)))
              ((symbol-function 'helheim-ewm-notifications--open)
               (lambda (_) (ert-fail "Unexpected history fallback"))))
      (helheim-ewm-notifications--activate notification))
    (should (equal (reverse calls)
                   (list (list :session ":1.42" "/org/freedesktop/Notifications"
                               "org.freedesktop.Notifications" "ActivationToken"
                               :uint32 1 "test-token")
                         (list 'action notification))))))

(ert-deftest helheim-ewm-notifications-inactive-or-actionless-opens-history ()
  (dolist (case '((nil ("default" "Open")) ((0) nil)
                  ((0) ("reply" "default"))))
    (let ((notification (helheim-ewm-notifications-test--notification))
          opened)
      (setf (ednc-notification-parent notification) (car case)
            (ednc-notification-actions notification) (cadr case))
      (cl-letf (((symbol-function 'helheim-ewm-notifications--open)
                 (lambda (value) (setq opened value)))
                ((symbol-function 'ednc-invoke-action)
                 (lambda (_) (ert-fail "Inactive or missing default action invoked"))))
        (helheim-ewm-notifications--activate notification))
      (should (eq opened notification)))))

(ert-deftest helheim-ewm-notifications-echo-click-dispatch ()
  (let* ((notification (helheim-ewm-notifications-test--notification))
         (text (helheim-ewm-notifications--preview notification))
         activated messages)
    (cl-letf (((symbol-function 'event-start) (lambda (_) 'position))
              ((symbol-function 'posn-string) (lambda (_) nil))
              ((symbol-function 'current-message) (lambda () text))
              ((symbol-function 'active-minibuffer-window) (lambda () nil))
              ((symbol-function 'helheim-ewm-notifications--activate)
               (lambda (value) (setq activated value)))
              ((symbol-function 'view-echo-area-messages)
               (lambda () (setq messages t))))
      (helheim-ewm-notifications--echo-click 'event)
      (should (eq activated notification))
      (should-not messages)
      (setq text "An ordinary Emacs message" activated nil)
      (helheim-ewm-notifications--echo-click 'event)
      (should messages)
      (should-not activated))))

(ert-deftest helheim-ewm-notifications-remaps-inactive-minibuffer-click ()
  (should (eq (lookup-key minibuffer-inactive-mode-map
                         [remap view-echo-area-messages])
              #'helheim-ewm-notifications--echo-click)))

(ert-deftest helheim-ewm-notifications-defers-during-prompts ()
  (let* ((notification (helheim-ewm-notifications-test--notification))
         (helheim-ewm-notifications--pending notification)
         (helheim-ewm-notifications--timer nil)
         scheduled)
    (cl-letf (((symbol-function 'active-minibuffer-window) (lambda () t))
              ((symbol-function 'run-at-time)
               (lambda (&rest args) (setq scheduled args)))
              ((symbol-function 'message) (lambda (&rest _) (ert-fail "Prompt overwritten"))))
      (helheim-ewm-notifications--flush))
    (should scheduled)
    (should (eq helheim-ewm-notifications--pending notification))))

(ert-deftest helheim-ewm-notifications-flushes-without-messages-log ()
  (let ((helheim-ewm-notifications--pending
         (helheim-ewm-notifications-test--notification))
        (helheim-ewm-notifications--timer nil)
        (helheim-ewm-notifications--clear-timer nil)
        shown)
    (cl-letf (((symbol-function 'active-minibuffer-window) (lambda () nil))
              ((symbol-function 'run-at-time)
               (lambda (delay _repeat function token)
                 (should (= delay helheim-ewm-notifications-preview-duration))
                 (should (eq function #'helheim-ewm-notifications--clear-preview))
                 (should (eq token (get-text-property 0 'helheim-ewm-preview-token shown)))
                 'clear-timer))
              ((symbol-function 'message)
               (lambda (_format text)
                 (should-not message-log-max)
                 (setq shown text))))
      (helheim-ewm-notifications--flush))
    (should shown)
    (should (eq helheim-ewm-notifications--clear-timer 'clear-timer))
    (should-not helheim-ewm-notifications--pending)))

(ert-deftest helheim-ewm-notifications-clears-only-its-own-preview ()
  (let* ((token (list 'preview))
         (text (propertize "Notification" 'helheim-ewm-preview-token token))
         (helheim-ewm-notifications--clear-timer nil)
         prompt cleared)
    (cl-letf (((symbol-function 'current-message) (lambda () text))
              ((symbol-function 'active-minibuffer-window) (lambda () prompt))
              ((symbol-function 'message)
               (lambda (value)
                 (should-not value)
                 (should-not message-log-max)
                 (setq cleared t))))
      (helheim-ewm-notifications--clear-preview token)
      (should cleared)
      (setq cleared nil prompt t)
      (helheim-ewm-notifications--clear-preview token)
      (should-not cleared)
      (setq prompt nil text "A newer Emacs message")
      (helheim-ewm-notifications--clear-preview token)
      (should-not cleared)
      (setq text (propertize "Newer notification"
                             'helheim-ewm-preview-token (list 'newer)))
      (helheim-ewm-notifications--clear-preview token)
      (should-not cleared))))

(ert-deftest helheim-ewm-notifications-retains-history-and-actions ()
  (let ((ednc-log-name " *helheim-ednc-test*"))
    (unwind-protect
        (let ((notification (helheim-ewm-notifications-test--notification)))
          (ednc--update-log-buffer nil notification)
          (with-current-buffer ednc-log-name
            (should (derived-mode-p 'ednc-view-mode))
            (should (string-match-p "Hello\nworld" (buffer-string)))
            (should (eq (get-text-property (point-min) 'ednc-notification)
                        notification)))
          (should (equal (ednc-notification-actions notification) '("default" "Open"))))
      (when (get-buffer ednc-log-name) (kill-buffer ednc-log-name)))))

(ert-deftest helheim-ewm-notifications-does-not-replace-server ()
  (let ((ewm-mode t)
        (ednc-mode nil)
        (helheim-ewm-notifications--started nil)
        warned)
    (cl-letf (((symbol-function 'dbus-list-names)
               (lambda (_) '("org.freedesktop.Notifications")))
              ((symbol-function 'display-warning) (lambda (&rest _) (setq warned t)))
              ((symbol-function 'ednc-mode) (lambda (&rest _) (ert-fail "Server replaced"))))
      (helheim-ewm-notifications--sync))
    (should warned)
    (should-not helheim-ewm-notifications--started)))

(ert-deftest helheim-ewm-notifications-starts-with-either-load-order ()
  (dolist (ewm-already-running '(nil t))
    (let ((ewm-mode ewm-already-running)
          (ewm-mode-hook (list #'helheim-ewm-notifications--sync))
          (ednc-mode nil)
          (helheim-ewm-notifications--started nil)
          starts)
      (cl-letf (((symbol-function 'dbus-list-names) (lambda (_) nil))
                ((symbol-function 'ednc-mode)
                 (lambda (arg)
                   (setq ednc-mode (> arg 0))
                   (when ednc-mode (push 'started starts)))))
        ;; The integration calls sync when loaded.  If EWM has not started
        ;; yet, its mode hook must start EDNC later, after daemon startup.
        (helheim-ewm-notifications--sync)
        (should (eq ednc-mode ewm-already-running))
        (setq ewm-mode t)
        (run-hooks 'ewm-mode-hook)
        (should ednc-mode)
        (should helheim-ewm-notifications--started)
        (should (equal starts '(started)))))))

(ert-deftest helheim-ewm-notifications-package-declared-at-startup ()
  (let* ((startup (expand-file-name
                   "user-lisp/helheim/ewm/helheim-ewm-notifications-setup.el"
                   helheim-ewm-notifications-test--root))
         declaration)
    (with-temp-buffer
      (insert-file-contents startup)
      (should (search-forward
               ";;;###autoload (with-eval-after-load 'helheim-setup (require 'helheim-ewm-notifications-setup))"
               nil t))
      (goto-char (point-min))
      (condition-case nil
          (while t
            (let ((form (read (current-buffer))))
              (when (and (eq (car-safe form) 'setup)
                         (eq (cadr form) 'ednc))
                (setq declaration form))))
        (end-of-file nil)))
    (should (member '(:install t) declaration))
    (should (member '(with-eval-after-load 'ewm
                       (require 'helheim-ewm-notifications))
                    declaration))))

(ert-deftest helheim-ewm-notifications-keeps-modeline-clean ()
  (should-not (alist-get 'ednc-mode minor-mode-alist))
  (should (memq #'ednc--update-log-buffer
                (ensure-list ednc-notification-presentation-functions))))

;;; helheim-ewm-notifications-tests.el ends here
